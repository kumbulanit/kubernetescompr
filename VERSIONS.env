# ==============================================================================
# AxisPay Kubernetes Training — Version Pins
# ==============================================================================
# Single source of truth. Sourced by every script; referenced by every manifest,
# Dockerfile and Helm chart. Nothing in this repository floats on ":latest".
#
#   source VERSIONS.env
#
# Changing a version here is a one-line edit. Verify with:
#   make preflight && make validate-all
# ==============================================================================

# ---- Course -----------------------------------------------------------------
COURSE_CODE="AXP-K8S-5D"
COURSE_VERSION="1.0.0"
PLATFORM_VERSION="1.0.0"          # bumped to 2.0.0 during the Day 5 capstone

# ---- Host -------------------------------------------------------------------
UBUNTU_VERSION="26.04"            # 24.04 LTS also supported
UBUNTU_CODENAME="resolute"

# ---- Cluster ----------------------------------------------------------------
# Supported range: v1.33 – v1.36. All manifests use stable APIs only.
KUBERNETES_VERSION="v1.36.2"
JAVA_VERSION="21"
MINIKUBE_PROFILE="axispay"
MINIKUBE_DRIVER="docker"
MINIKUBE_RUNTIME="containerd"
MINIKUBE_CNI="calico"             # REQUIRED — default CNI does not enforce NetworkPolicy
MINIKUBE_ADDONS="metrics-server,ingress,storage-provisioner"

# Profile A — recommended (8 vCPU / 16 GB host)
PROFILE_A_NODES=3
PROFILE_A_CPUS=2
PROFILE_A_MEMORY=4096

# Profile B — minimum (4 vCPU / 8 GB host)
PROFILE_B_NODES=2
PROFILE_B_CPUS=2
PROFILE_B_MEMORY=3072

MINIKUBE_DISK="20g"

# ---- Client tooling ---------------------------------------------------------
KUBECTL_VERSION="v1.36.2"         # must be within one minor of the cluster
HELM_VERSION="v3.16.4"
KUSTOMIZE_VERSION="v5.5.0"

# ---- Base images ------------------------------------------------------------
PYTHON_IMAGE="python:3.13-slim-bookworm"
POSTGRES_IMAGE="postgres:17-alpine"
REDIS_IMAGE="redis:7.4-alpine"
RABBITMQ_IMAGE="rabbitmq:4-management-alpine"
BUSYBOX_IMAGE="busybox:1.37"      # init containers, netcat wait-for
CURL_IMAGE="curlimages/curl:8.11.1"   # network debugging pods

# ---- AxisPay images ---------------------------------------------------------
# Built locally into the Minikube runtime. No registry, no push, no pull limits.
IMAGE_REGISTRY=""                 # intentionally empty — local build
IMAGE_NAMESPACE="axispay"
# Three tags are used across the week, in this order:
#   1.0.0  Days 1-2 initial deployment, and the chart's appVersion
#   1.1.0  L2.6 rolling update target — the zero-downtime release
#   2.0.0  the capstone upgrade (new fraud model, settlement schema migration)
IMAGE_TAG="1.0.0"
IMAGE_TAG_V1_1="1.1.0"            # L2.6 rolling-update target
IMAGE_TAG_V2="2.0.0"              # capstone upgrade target
IMAGE_PULL_POLICY="IfNotPresent"

# Build order follows the course: Day 1 services first, then Day 2, then Day 3.
AXISPAY_SERVICES="edge-gateway auth-service merchant-service payment-service \
fraud-service routing-service node-agent recon-worker loadgen \
customer-service ledger-service \
settlement-service notification-service audit-service reporting-service \
alert-sink"

# ---- Observability (Day 5) --------------------------------------------------
KUBE_PROM_STACK_VERSION="66.3.0"
LOKI_CHART_VERSION="6.24.0"
ALLOY_CHART_VERSION="0.10.1"
PROMETHEUS_RETENTION="6h"         # short — this is a laptop, not production

# ---- Namespaces -------------------------------------------------------------
NS_EDGE="axispay-edge"
NS_CORE="axispay-core"
NS_ASYNC="axispay-async"
NS_DATA="axispay-data"
NS_OBS="axispay-observability"
NS_OPS="axispay-ops"

# ---- Application defaults ---------------------------------------------------
APP_PORT=8080
APP_UID=10001
APP_GID=10001
LOG_LEVEL="info"
DEFAULT_CURRENCY="ZAR"
SUPPORTED_CURRENCIES="ZAR,USD,EUR,GBP,NGN,KES,BWP"

# ---- SLO targets (defended during the capstone) -----------------------------
SLO_AVAILABILITY_PCT="99.5"
SLO_P99_LATENCY_MS="300"

# ---- Ingress hosts (add to /etc/hosts via scripts/setup/03-create-cluster.sh)
INGRESS_HOST_API="api.axispay.local"
INGRESS_HOST_PORTAL="portal.axispay.local"
INGRESS_HOST_GRAFANA="grafana.axispay.local"

JAVA_VERSION="21"
