%% D3 M3.2 — what actually protects a Secret
graph TB
    S["<b>Secret</b><br/>base64-encoded<br/><b>NOT encrypted</b>"]
    L1["kubectl get secret -o yaml<br/>| base64 -d"]
    L2["kubectl describe pod<br/><i>if used as a plain env var</i>"]
    L3["etcd backup<br/><i>if not encrypted at rest</i>"]
    L4["child process inherits<br/>the environment"]
    C1["<b>RBAC</b> — who may get secrets"]
    C2["<b>etcd encryption at rest</b>"]
    C3["<b>mount as a volume</b>, not an env var"]
    C4["<b>external secret manager</b><br/>short-lived, rotatable"]
    S --> L1
    S --> L2
    S --> L3
    S --> L4
    C1 -.->|blocks| L1
    C2 -.->|blocks| L3
    C3 -.->|blocks| L2
    C3 -.->|blocks| L4
    C4 -.->|the real answer| S
    style S fill:#3b2f1f,stroke:#ffa726,color:#fff
    style L1 fill:#3b1f1f,stroke:#d32f2f,color:#fff
    style L2 fill:#3b1f1f,stroke:#d32f2f,color:#fff
    style L3 fill:#3b1f1f,stroke:#d32f2f,color:#fff
    style L4 fill:#3b1f1f,stroke:#d32f2f,color:#fff
    style C1 fill:#1f3b2b,stroke:#66bb6a,color:#fff
    style C4 fill:#1f3b2b,stroke:#66bb6a,color:#fff
