# ==============================================================================
# AxisPay shared base image
# Java / Spring Boot runtime
# ==============================================================================
FROM eclipse-temurin:21-jre

RUN groupadd --gid 10001 axispay   && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin axispay

WORKDIR /app
USER 10001:10001
EXPOSE 8080
