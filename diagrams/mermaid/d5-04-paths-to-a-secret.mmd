%% D5 M5.2 — an RBAC review that checks a RESOURCE has audited the wrong thing
graph LR
    ATT["someone with<br/>namespace access"]
    S1["get / list on <b>secrets</b><br/><i>the obvious one</i>"]
    S2["create on <b>pods/exec</b><br/>kubectl exec -- printenv"]
    S3["create on <b>pods</b><br/>mount the Secret into<br/>a pod you create"]
    S4["create on <b>pods/portforward</b><br/>reach a service that exposes it"]
    S5["<b>escalate</b> / <b>bind</b><br/>grant yourself the first one"]
    S6["<b>impersonate</b><br/>become someone who has it"]
    SEC[("the JWT<br/>signing key")]
    ATT --> S1 --> SEC
    ATT --> S2 --> SEC
    ATT --> S3 --> SEC
    ATT --> S4 --> SEC
    ATT --> S5 --> SEC
    ATT --> S6 --> SEC
    style S1 fill:#1f2b3b,stroke:#42a5f5,color:#fff
    style S2 fill:#3b1f1f,stroke:#d32f2f,color:#fff
    style SEC fill:#3b2f1f,stroke:#ffa726,color:#fff
